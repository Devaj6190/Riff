# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LLM: Muse Spark via Meta Model API (OpenAI-compatible). Swap all three to fall back to another provider.
META_API_KEY=
META_BASE_URL=
LLM_MODEL=

# xAI: Grok Imagine (images), Grok speech-to-text, and the automatic LLM fallback when the primary errors
XAI_API_KEY=
# Optional; defaults to grok-4.20-0309-non-reasoning
LLM_FALLBACK_MODEL=

# Game length: target score for new games (default 100). Set 50 for Expo mode.
RIFF_TARGET_SCORE=

# Jev (TypeSafe System One model): ranks people in search. Early access: https://typesafe.ai. Without it, search ranks by word overlap.
TYPESAFE_API_KEY=
